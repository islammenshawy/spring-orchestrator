{
  "editable": true,
  "panels": [
    {
      "title": "Critical Errors",
      "type": "logs",
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 0 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [{"expr": "{service=\"digital-instrument-service\"} |~ \"DLT|Dead-letter|COMPENSATION_FAILED|Both DCs unhealthy|Failover failed\"", "refId": "A"}],
      "options": { "showTime": true, "sortOrder": "Descending", "enableLogDetails": true }
    },
    {
      "title": "Step Executions / min",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [{"expr": "sum(count_over_time({service=\"digital-instrument-service\"} |~ \"Executing step\" [1m]))", "legendFormat": "steps", "refId": "A", "queryType": "range"}]
    },
    {
      "title": "Errors by Type / min",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {"expr": "sum(count_over_time({service=\"digital-instrument-service\"} |~ \"DLT\" [1m]))", "legendFormat": "DLT", "refId": "A", "queryType": "range"},
        {"expr": "sum(count_over_time({service=\"digital-instrument-service\"} |~ \"Outbox.*Failed\" [1m]))", "legendFormat": "Outbox", "refId": "B", "queryType": "range"},
        {"expr": "sum(count_over_time({service=\"digital-instrument-service\"} |~ \"Compensation failed\" [1m]))", "legendFormat": "Compensation", "refId": "C", "queryType": "range"},
        {"expr": "sum(count_over_time({service=\"digital-instrument-service\"} |~ \"Infrastructure error\" [1m]))", "legendFormat": "Infra", "refId": "D", "queryType": "range"}
      ]
    },
    {
      "title": "All DIS Logs",
      "type": "logs",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 14 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [{"expr": "{service=\"digital-instrument-service\"}", "refId": "A"}],
      "options": { "showTime": true, "sortOrder": "Descending", "enableLogDetails": true }
    },
    {
      "title": "Vendor Retries / min",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {"expr": "sum(count_over_time({service=\"digital-instrument-service\"} |~ \"RETRYING|RetryableStepException\" [1m]))", "legendFormat": "Retryable", "refId": "A", "queryType": "range"},
        {"expr": "sum(count_over_time({service=\"digital-instrument-service\"} |~ \"NonRetryableStepException\" [1m]))", "legendFormat": "Non-Retryable", "refId": "B", "queryType": "range"}
      ]
    },
    {
      "title": "Failover Events",
      "type": "logs",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [{"expr": "{service=\"digital-instrument-service\"} |~ \"Failover\"", "refId": "A"}],
      "options": { "showTime": true, "sortOrder": "Descending" }
    },
    {
      "title": "Signals / min",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 32 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {"expr": "sum(count_over_time({service=\"digital-instrument-service\"} |~ \"Signal.*Executed\" [1m]))", "legendFormat": "Executed", "refId": "A", "queryType": "range"},
        {"expr": "sum(count_over_time({service=\"digital-instrument-service\"} |~ \"Signal.*Queued\" [1m]))", "legendFormat": "Queued", "refId": "B", "queryType": "range"}
      ]
    },
    {
      "title": "Recovery Scanner",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 32 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {"expr": "sum(count_over_time({service=\"digital-instrument-service\"} |~ \"Recovery.*Claimed\" [1m]))", "legendFormat": "Claimed", "refId": "A", "queryType": "range"},
        {"expr": "sum(count_over_time({service=\"digital-instrument-service\"} |~ \"orphaned claims\" [1m]))", "legendFormat": "Orphaned", "refId": "B", "queryType": "range"}
      ]
    },
    {
      "title": "Kafka Broker Logs (WARN/ERROR)",
      "type": "logs",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 40 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [{"expr": "{service=~\"kafka-.*\"} |~ \"WARN|ERROR\"", "refId": "A"}],
      "options": { "showTime": true, "sortOrder": "Descending" }
    }
  ],
  "schemaVersion": 39,
  "tags": ["dis", "orchestrator"],
  "time": { "from": "now-30m", "to": "now" },
  "title": "DIS Overview",
  "uid": "dis-overview",
  "refresh": "10s"
}
