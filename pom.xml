<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.5</version>
        <relativePath/>
    </parent>

    <groupId>com.enigio.orchestrator</groupId>
    <artifactId>spring-orchestrator-parent</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>Spring Orchestrator</name>

    <!--
      ============================================================
      PRODUCTION MODULES (will be extracted as standalone repos):
        orchestrator-starter        — reusable orchestration library
        digital-instrument-service  — Enigio trace:original integration
        mock-vendor                 — vendor API simulator for testing

      EXAMPLES:
        examples/sample-app         — usage example
        examples/dashboard          — monitoring UI

      REFERENCE (comparison only, not for production):
        alternative-frameworks/common, alternative-frameworks/saga-outbox,
        alternative-frameworks/statemachine, alternative-frameworks/spring-integration
      ============================================================
    -->

    <!-- Default build: production modules -->
    <modules>
        <module>orchestrator-starter</module>
        <module>digital-instrument-service</module>
        <module>mock-vendor</module>
    </modules>

    <profiles>
        <!-- Build everything: mvn package -P all -->
        <profile>
            <id>all</id>
            <modules>
                <module>orchestrator-starter</module>
                <module>digital-instrument-service</module>
                <module>mock-vendor</module>
                <module>examples/sample-app</module>
                <module>examples/dashboard</module>
                <module>alternative-frameworks/common</module>
                <module>alternative-frameworks/saga-outbox</module>
                <module>alternative-frameworks/statemachine</module>
                <module>alternative-frameworks/spring-integration</module>
            </modules>
        </profile>
    </profiles>

    <properties>
        <java.version>21</java.version>
        <lombok.version>1.18.38</lombok.version>
        <spring-statemachine.version>4.0.0</spring-statemachine.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.enigio.orchestrator</groupId>
                <artifactId>orchestrator-common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.enigio.orchestrator</groupId>
                <artifactId>orchestrator-starter</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springframework.statemachine</groupId>
                <artifactId>spring-statemachine-core</artifactId>
                <version>${spring-statemachine.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
