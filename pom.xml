<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.5</version>
        <relativePath/>
    </parent>

    <groupId>com.enigio.orchestrator</groupId>
    <artifactId>spring-orchestrator-parent</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>Spring Orchestrator</name>

    <!--
      ============================================================
      PUBLISHABLE LIBRARY (what teams depend on):
        orchestrator-starter  — the reusable library
        sample-app            — usage example

      REFERENCE / DEMO (comparison only, not for production use):
        common, saga-outbox, statemachine, spring-integration,
        mock-vendor, dashboard
      ============================================================
    -->

    <!-- Default build: only the library and sample app -->
    <modules>
        <module>orchestrator-starter</module>
        <module>sample-app</module>
    </modules>

    <profiles>
        <!-- Build everything including reference implementations:
             mvn package -P demo -->
        <profile>
            <id>demo</id>
            <modules>
                <module>orchestrator-starter</module>
                <module>sample-app</module>
                <module>common</module>
                <module>mock-vendor</module>
                <module>saga-outbox</module>
                <module>statemachine</module>
                <module>spring-integration</module>
                <module>dashboard</module>
            </modules>
        </profile>
    </profiles>

    <properties>
        <java.version>21</java.version>
        <lombok.version>1.18.38</lombok.version>
        <spring-statemachine.version>4.0.0</spring-statemachine.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.enigio.orchestrator</groupId>
                <artifactId>orchestrator-common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.enigio.orchestrator</groupId>
                <artifactId>orchestrator-starter</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springframework.statemachine</groupId>
                <artifactId>spring-statemachine-core</artifactId>
                <version>${spring-statemachine.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
