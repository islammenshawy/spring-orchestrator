<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.5</version>
        <relativePath/>
    </parent>

    <groupId>com.enigio.orchestrator</groupId>
    <artifactId>spring-orchestrator-parent</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>Spring Orchestrator</name>

    <!--
      ============================================================
      Each production module (orchestrator-starter, digital-instrument-service,
      mock-vendor) is fully self-contained — its own parent, dependencies,
      and build config. They can be extracted to standalone repos.

      This parent pom exists only for convenience: building all modules
      together in this mono-repo.
      ============================================================
    -->

    <!-- Default build: production modules -->
    <modules>
        <module>orchestrator-starter</module>
        <module>digital-instrument-service</module>
        <module>mock-vendor</module>
    </modules>

    <profiles>
        <!-- Build everything: mvn package -P all -->
        <profile>
            <id>all</id>
            <modules>
                <module>orchestrator-starter</module>
                <module>digital-instrument-service</module>
                <module>mock-vendor</module>
                <module>examples/sample-app</module>
                <module>examples/dashboard</module>
                <module>alternative-frameworks/common</module>
                <module>alternative-frameworks/saga-outbox</module>
                <module>alternative-frameworks/statemachine</module>
                <module>alternative-frameworks/spring-integration</module>
            </modules>
        </profile>
    </profiles>
</project>
