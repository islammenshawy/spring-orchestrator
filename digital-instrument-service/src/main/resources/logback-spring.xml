<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- PII masking converter — masks emails, phones, org numbers in all log output -->
    <conversionRule conversionWord="maskedMsg"
                    converterClass="com.dis.instrument.config.PiiMaskingConverter"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} %5level [%thread] %logger{40} - %maskedMsg%n</pattern>
        </encoder>
    </appender>

    <!-- JSON appender for Splunk/structured logging (production) -->
    <springProfile name="prod,staging">
        <appender name="JSON" class="ch.qos.logback.core.ConsoleAppender">
            <encoder class="ch.qos.logback.classic.encoder.JsonEncoder">
                <!-- JsonEncoder auto-includes timestamp, level, logger, thread, message, MDC -->
            </encoder>
        </appender>
        <root level="INFO">
            <appender-ref ref="JSON"/>
        </root>
    </springProfile>

    <!-- Console appender for local/test -->
    <springProfile name="!prod &amp; !staging">
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>
    </springProfile>

    <!-- Reduce noise from libraries -->
    <logger name="org.apache.kafka" level="WARN"/>
    <logger name="org.mongodb.driver" level="WARN"/>
    <logger name="io.mongock" level="WARN"/>
    <logger name="org.springframework.kafka" level="WARN"/>
    <logger name="org.springframework.data.mongodb" level="WARN"/>
</configuration>
